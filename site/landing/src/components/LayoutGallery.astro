---
// 6 套布局横向滑动
const layouts = [
  { name: '全行网格绕排', desc: '分类胶囊 + 全宽网格，信息密度最高，178 首无压力。', status: 'live' },
  { name: '杂志双栏版', desc: '衬线刊头 + 双栏大留白，海报感最强，适合社交平台发布。', status: 'plan' },
  { name: '环绕主体版 ★', desc: '歌名绕月亮/花束/唱片环排，不压背景主体，最"惊艳"。', status: 'plan' },
  { name: '便签拼贴版', desc: '撕纸便签 + 微旋转 + 纸胶带，手账感，与奶油主题绝配。', status: 'plan' },
  { name: '河流曲线版', desc: '歌名沿贝塞尔曲线排布，文字沿线微旋转，海洋主题 Signature。', status: 'plan' },
  { name: '极简清单版', desc: '单列大留白 + 字号分级，本周新歌放大，高级感封面。', status: 'plan' },
];
---
<section class="reveal max-w-container mx-auto px-16 py-20">
  <div class="font-mono text-[11px] font-semibold uppercase tracking-[2px] mb-3"
    style="color: var(--spotlight);">布局系统</div>
  <h2 class="font-serif text-4xl md:text-5xl font-bold tracking-tight leading-tight mb-4">
    6 套布局，从规整到自由
  </h2>
  <p class="text-base max-w-[560px] mb-10 leading-relaxed" style="color: var(--text-2);">
    同一首歌单 × 不同的"排版风格" = 截然不同的海报气质。环绕背景元素的 halo 版将于 2026 Q3 上线。
  </p>

  <div class="flex gap-5 overflow-x-auto pb-3 snap-x snap-mandatory">
    {layouts.map((l, i) => (
      <div class={`layout-card reveal reveal-d${(i % 4) + 1}`}>
        <span class={`ltag ${l.status === 'live' ? 'ltag-live' : 'ltag-plan'}`}>
          {l.status === 'live' ? 'v1 已上线' : 'v2 规划中'}
        </span>
        <h4 class="font-serif text-[17px] font-semibold mb-1.5">{l.name}</h4>
        <p class="text-[13px] leading-relaxed" style="color: var(--text-3);">{l.desc}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .layout-card {
    flex: 0 0 240px;
    scroll-snap-align: start;
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 24px;
    transition: all 0.3s var(--ease-out);
    cursor: pointer;
  }
  .layout-card:hover {
    border-color: var(--primary);
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }
  .ltag {
    display: inline-block;
    padding: 3px 8px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 600;
    margin-bottom: 12px;
    font-family: var(--font-mono);
  }
  .ltag-live { background: var(--primary-soft); color: var(--primary); }
  .ltag-plan { background: var(--accent-soft); color: var(--accent); }
  /* 滚动条 */
  .flex::-webkit-scrollbar { height: 4px; }
  .flex::-webkit-scrollbar-thumb { background: var(--border-strong); border-radius: 4px; }
</style>