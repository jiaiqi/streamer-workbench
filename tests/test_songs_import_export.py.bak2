"""L2.3 曲库导入导出（/api/songs/export + /api/songs/import）端到端测试。"""
from __future__ import annotations

import asyncio
import json
import sys
import tempfile
import unittest
from pathlib import Path
from urllib.parse import urlsplit

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from server.config import AppConfig


PROJECT_ROOT = Path(__file__).resolve().parents[1]


def _boot_app(data_root: Path):
    from server.app import create_app
    return create_app(AppConfig(PROJECT_ROOT, mode="test", data_root=data_root))


async def _raw_request(app, method, path, payload=None, headers=None):
    target = urlsplit(path)
    body = (json.dumps(payload, ensure_ascii=False).encode("utf-8")
            if payload is not None else b"")
    sent = False
    messages: list = []

    async def receive():
        nonlocal sent
        if not sent:
            sent = True
            return {"type": "http.request", "body": body, "more_body": False}
        return {"type": "http.disconnect"}

    async def send(message):
        messages.append(message)

    try:
        await app({
            "type": "http", "asgi": {"version": "3.0"}, "http_version": "1.1",
            "method": method, "scheme": "http", "path": target.path,
            "raw_path": target.path.encode(),
            "query_string": target.query.encode(),
            "headers": [
                (key.lower().encode(), value.encode())
                for key, value in ({"content-type": "application/json"} | (headers or {})).items()
            ],
            "client": ("test", 1), "server": ("test", 80),
        }, receive, send)
    except Exception:
        if not any(m["type"] == "http.response.start" for m in messages):
            raise

    status = next(m["status"] for m in messages if m["type"] == "http.response.start")
    response_start = next(m for m in messages if m["type"] == "http.response.start")
    headers_dict = {k.decode("ascii").lower(): v.decode("ascii")
                    for k, v in response_start.get("headers", [])}
    body_chunks = [bytes(m.get("body", b"")) for m in messages if m["type"] == "http.response.body"]
    return status, b"".join(body_chunks), headers_dict


def _write_songs_json(data_root, payload):
    songs_path = data_root / "songs.json"
    songs_path.parent.mkdir(parents=True, exist_ok=True)
    songs_path.write_text(json.dumps(payload, ensure_ascii=False), encoding="utf-8")


def _song(title, **over):
    base = {"id": "", "title": title, "artists": [], "lyricist": "", "composer": "",
            "key": "", "capo": 0, "difficulty": "", "tabs": "", "status": "active",
            "tags": [], "pinyin": "", "added_at": "", "notes": "", "learned_at": "",
            "tab_files": [], "section": 1, "lyrics_lrc": "", "lyrics_plain": "",
            "audio_vocal_path": None, "audio_instrumental_path": None,
            "audio_duration_ms": 0, "deleted_at": None,
            "capo_options": [], "capo_default": 0}
    base.update(over)
    return base


class SongsImportExportTests(unittest.TestCase):
    def test_export_empty_library(self):
        async def scenario():
            with tempfile.TemporaryDirectory() as raw:
                app = _boot_app(Path(raw))
                async with app.router.lifespan_context(app):
                    status, body, _ = await _raw_request(app, "GET", "/api/songs/export")
                    self.assertEqual(status, 200, body)
                    payload = json.loads(body)
                    self.assertIn("schema_version", payload)
                    self.assertIn("version", payload)
                    self.assertEqual(payload["songs"], [])
                    self.assertIn("exported_at", payload)
        asyncio.run(scenario())

    def test_export_with_songs(self):
        async def scenario():
            with tempfile.TemporaryDirectory() as raw:
                data_root = Path(raw)
                _write_songs_json(data_root, {
                    "version": 5,
                    "songs": [_song("晴天"), _song("夜曲"), _song("稻香", status="draft")],
                })
                app = _boot_app(data_root)
                async with app.router.lifespan_context(app):
                    status, body, _ = await _raw_request(app, "GET", "/api/songs/export")
                    self.assertEqual(status, 200)
                    payload = json.loads(body)
                    self.assertEqual(len(payload["songs"]), 3)
                    titles = {s["title"] for s in payload["songs"]}
                    self.assertEqual(titles, {"晴天", "夜曲", "稻香"})
        asyncio.run(scenario())

    def test_import_merge_skips_duplicates(self):
        async def scenario():
            with tempfile.TemporaryDirectory() as raw:
                data_root = Path(raw)
                _write_songs_json(data_root, {"version": 5, "songs": [_song("晴天")]})
                app = _boot_app(data_root)
                async with app.router.lifespan_context(app):
                    status, body, _ = await _raw_request(
                        app, "POST", "/api/songs/import",
                        {"mode": "merge",
                         "songs": [
                             {"title": "晴天"},
                             {"title": "夜曲"},
                             {"title": "稻香", "status": "draft"},
                         ]})
                    self.assertEqual(status, 200, body)
                    payload = json.loads(body)
                    self.assertEqual(payload["added"], 2)
                    self.assertEqual(payload["skipped"], 1)
                    self.assertEqual(payload["active"], 2)
                    self.assertEqual(payload["draft"], 1)
                    self.assertEqual(payload["errors"], [])
        asyncio.run(scenario())

    def test_import_replace_clears_existing(self):
        async def scenario():
            with tempfile.TemporaryDirectory() as raw:
                data_root = Path(raw)
                _write_songs_json(data_root, {
                    "version": 5, "songs": [_song("晴天"), _song("夜曲")]})
                app = _boot_app(data_root)
                async with app.router.lifespan_context(app):
                    status, body, _ = await _raw_request(
                        app, "POST", "/api/songs/import",
                        {"mode": "replace", "songs": [{"title": "新歌A"}, {"title": "新歌B"}]})
                    self.assertEqual(status, 200, body)
                    payload = json.loads(body)
                    self.assertEqual(payload["added"], 2)
                    self.assertEqual(payload["skipped"], 0)
                    self.assertEqual(payload["active"], 2)
        asyncio.run(scenario())

    def test_import_invalid_mode_returns_400(self):
        async def scenario():
            with tempfile.TemporaryDirectory() as raw:
                app = _boot_app(Path(raw))
                async with app.router.lifespan_context(app):
                    status, body, _ = await _raw_request(
                        app, "POST", "/api/songs/import",
                        {"mode": "replace-all", "songs": [{"title": "X"}]})
                    self.assertEqual(status, 400, body)
                    payload = json.loads(body)
                    self.assertEqual(payload["error"]["code"], "validation_failed")
        asyncio.run(scenario())

    def test_import_empty_songs_rejected(self):
        async def scenario():
            with tempfile.TemporaryDirectory() as raw:
                app = _boot_app(Path(raw))
                async with app.router.lifespan_context(app):
                    status, body, _ = await _raw_request(
                        app, "POST", "/api/songs/import",
                        {"mode": "merge", "songs": []})
                    self.assertEqual(status, 422)
        asyncio.run(scenario())

    def test_round_trip_export_import_equivalent(self):
        async def scenario():
            with tempfile.TemporaryDirectory() as raw:
                data_root = Path(raw)
                _write_songs_json(data_root, {
                    "version": 5, "songs": [_song("晴天"), _song("夜曲")]})
                app = _boot_app(data_root)
                async with app.router.lifespan_context(app):
                    status, body, _ = await _raw_request(app, "GET", "/api/songs/export")
                    self.assertEqual(status, 200)
                    exported = json.loads(body)
                    self.assertEqual(len(exported["songs"]), 2)
                    status, body, _ = await _raw_request(
                        app, "POST", "/api/songs/import",
                        {"mode": "merge", "songs": [
                            {"title": s["title"]} for s in exported["songs"]
                        ]})
                    self.assertEqual(status, 200, body)
                    payload = json.loads(body)
                    self.assertEqual(payload["added"], 0)
                    self.assertEqual(payload["skipped"], 2)
        asyncio.run(scenario())

    def test_import_handles_missing_title(self):
        async def scenario():
            with tempfile.TemporaryDirectory() as raw:
                app = _boot_app(Path(raw))
                async with app.router.lifespan_context(app):
                    status, body, _ = await _raw_request(
                        app, "POST", "/api/songs/import",
                        {"mode": "merge", "songs": [
                            {"title": ""},
                            {"title": "正常歌"},
                        ]})
                    self.assertEqual(status, 200, body)
                    payload = json.loads(body)
                    self.assertEqual(payload["added"], 1)
                    self.assertEqual(payload["skipped"], 1)
                    self.assertEqual(len(payload["errors"]), 1)
                    self.assertIn("缺标题", payload["errors"][0])
        asyncio.run(scenario())


if __name__ == "__main__":
    unittest.main()
